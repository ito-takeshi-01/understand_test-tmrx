# und settings の引数に使用するパラメータを列挙します。
# 1 行につき 1 つの設定オプションを記載します。
-Languages C++


# =====================================
# C/C++ コンパイラ設定
# =====================================

# 標準インクルードを使用
-C++AnalyzePreprocessorUseDefaultIncludes
Yes

-C++AnalyzePreprocessorDefaultIncludesStd
Yes

# 標準Cの定義
-C++AnalyzePreprocessorDefine
__STDC__=1

-C++AnalyzePreprocessorDefine
__STDC_VERSION__=201112L

# Windows環境の基本定義
-C++AnalyzePreprocessorDefine
_WIN32=1

-C++AnalyzePreprocessorDefine
_WIN64=1

# 厳密モードを無効化（エラーを警告に変更）
-C++AnalyzeStrictMode
No

# 不明な#includeを許可
-C++AnalyzePreprocessorAllowUnknownIncludes
Yes

# =====================================
# 追加設定: 欠落しているインクルードを無視
# =====================================

# 欠落しているシステムヘッダーを無視
-C++IgnoreMissingIncludes
on

# C標準を指定
-C++Standard
c11

# Visual Studioのパス検索を無効化（クロスプラットフォーム対応）
-C++ParseUseVCPP
No

# Clangパーサーの設定
-C++ParseUseClang
Yes

# 診断メッセージを警告レベルに抑制
-C++DiagnosticSuppressLevel
Warning