# und settings の引数に使用するパラメータを列挙します。
# 1 行につき 1 つの設定オプションを記載します。
-Languages C++


# =====================================
# C/C++ コンパイラ設定
# =====================================
# und settings の引数に使用するパラメータを列挙します。
# 1 行につき 1 つの設定オプションを記載します。

# =====================================
# 言語設定
# =====================================
-Languages
C++

# =====================================
# Visual Studio を使用しない設定
# =====================================

# Visual Studio のパーサーを使用しない（重要！）
-C++ParseUseVCPP
No

# Clang パーサーを使用（Understand 内蔵）
-C++ParseUseClang
Yes

# =====================================
# エラー無視設定
# =====================================

# 厳密モードを無効化
-C++AnalyzeStrictMode
No

# 欠落しているインクルードファイルを無視
-C++IgnoreMissingIncludes
on

# 不明な#includeを許可
-C++AnalyzePreprocessorAllowUnknownIncludes
Yes

# =====================================
# C標準設定
# =====================================

# C標準バージョン
-C++Standard
c11

# 標準インクルードを使用（Understand内蔵）
-C++AnalyzePreprocessorUseDefaultIncludes
Yes

-C++AnalyzePreprocessorDefaultIncludesStd
Yes

# =====================================
# プリプロセッサ定義
# =====================================

# 標準Cの定義
-C++AnalyzePreprocessorDefine
__STDC__=1

-C++AnalyzePreprocessorDefine
__STDC_VERSION__=201112L

# Windows環境の基本定義
-C++AnalyzePreprocessorDefine
_WIN32=1

-C++AnalyzePreprocessorDefine
_WIN64=1

-C++AnalyzePreprocessorDefine
_MSC_VER=1900

# =====================================
# 診断設定
# =====================================

# 警告レベルを下げる
-C++DiagnosticSuppressLevel
Warning